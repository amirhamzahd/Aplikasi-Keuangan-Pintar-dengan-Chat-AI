generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String         @id @default(uuid())
  email             String         @unique
  name              String
  gender            String?
  photo             String?
  password          String
  isVerified        Boolean        @default(false)
  verificationToken String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  monthlyCutoffDate Int            @default(1)
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  
  isPremium         Boolean        @default(false)
  premiumUntil      DateTime?
  
  planType          String         @default("NONE") // NONE, BASIC, PLUS, PRO
  planExpiredAt     DateTime?
  
  // Relasi
  accounts          Account[]
  categories        Category[]
  transactions      Transaction[]
  budgets           Budget[]
  goals             Goal[]
  subscriptions     Subscription[]
  debts             Debt[]
  paymentTransactions PaymentTransaction[]
}

model Account {
  id        String   @id @default(uuid())
  name      String
  type      String   // cash, bank, ewallet
  balance   Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  // Relasi dari tabel lain ke Account
  transactionsFrom Transaction[]  @relation("AccountFrom")
  transactionsTo   Transaction[]  @relation("AccountTo")
  subscriptions    Subscription[]
}

model Category {
  id        String   @id @default(uuid())
  name      String
  type      String   // income, expense
  icon      String
  color     String
  isBuiltIn Boolean  @default(false)
  
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String?

  transactions Transaction[]
  budgets      Budget[]
}

model Transaction {
  id          String   @id @default(uuid())
  amount      Float
  date        DateTime @default(now())
  description String
  type        String   // income, expense, transfer
  
  category    Category @relation(fields: [categoryId], references: [id])
  categoryId  String
  
  tags        String   // Dipertahankan sebagai string untuk UI compatibility
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String

  account     Account  @relation("AccountFrom", fields: [accountId], references: [id], onDelete: Cascade)
  accountId   String
  
  toAccount   Account? @relation("AccountTo", fields: [toAccountId], references: [id], onDelete: SetNull)
  toAccountId String?
}

model Budget {
  id        String   @id @default(uuid())
  
  category  Category @relation(fields: [categoryId], references: [id])
  categoryId String
  
  amount    Float
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  @@unique([userId, categoryId])
}

model Goal {
  id         String   @id @default(uuid())
  name       String
  target     Float
  current    Float    @default(0)
  targetDate DateTime
  createdAt  DateTime @default(now())
  
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
}

model Subscription {
  id          String   @id @default(uuid())
  name        String
  amount      Float
  cycle       String   // monthly, yearly
  category    String   // Dipertahankan sbg string
  startDate   DateTime
  nextPayment DateTime
  isActive    Boolean  @default(true)
  
  account     Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  accountId   String?

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
}

model Debt {
  id        String   @id @default(uuid())
  name      String
  type      String   // give, take
  amount    Float
  remaining Float
  dueDate   DateTime
  status    String   // active, paid
  createdAt DateTime @default(now())
  accountId String?
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
}

model PaymentTransaction {
  id            String   @id @default(uuid())
  orderId       String   @unique
  amount        Float
  status        String   // pending, success, failed
  paymentUrl    String?
  planType      String   @default("NONE") // Menyimpan paket apa yang sedang dibeli
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
}
